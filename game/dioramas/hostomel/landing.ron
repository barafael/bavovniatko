// Hostomel, sub-chapter I, The landing (Десант): 24 February 2022, late morning. About 34 helicopters bring 200-300
// VDV of the 31st Air Assault and 45th Spetsnaz Brigades onto the field; fewer than 200 National Guard conscripts
// of the 4th Rapid Reaction Brigade's rear echelon hold them for more than an hour, then pull out, out of ammunition
// (c01 §2 the timeline, §4, §6 set piece 2). The schema is bav_core::data and bav_sim::data; the map is map.ron.
//
// Phase 1 of design/hostomel.md: the field and the clock. The helicopters, the infantry fight and the Igla come in
// phases 2 to 4; until then the attack's lines below are set so nothing in the column game fires.
(
    // 10:20 to about 13:05 in the day's 1500 s: the stream crosses the Kyiv dam about 10:30 and is over the field
    // about 11:00; the defenders are out by 13:00.
    day_start_min: 620.0,
    compression: 0.11,
    attacker: Ru,
    // Fictional, the National Guard's: the player (viburnum), the D-30s at Horenka (mace), the observers on the
    // tower (tower), the battalion's command post (oak).
    callsigns: (player: ("Kalyna", "Калина"), guns: ("Bulava", "Булава"), op: ("Vezha", "Вежа"), command: ("Dub", "Дуб")),
    words: (
        briefing: r#"HOSTOMEL (ГОСТОМЕЛЬ), ANTONOV AIRPORT
24 FEBRUARY 2022, LATE MORNING

At four this morning Russia invaded. At dawn Kalibr missiles hit this airfield and the National Guard's base
beside it. The airport has a 3.5 km runway, 25 km from Kyiv: whoever holds it can fly an army in.

The 4th Rapid Reaction Brigade (4-та бригада оперативного призначення НГУ) has gone east. Its rear echelon is
left: fewer than two hundred conscripts, with rifles, a few BTRs, Igla missiles and one ZU-23-2.
Two D-30 howitzers stand at Horenka (Горенка).

Helicopters are coming down the Dnipro. Dozens of them.

The day will run whether or not you do anything. What you do decides how long the field holds.

Mouse: right-drag to look, wheel to zoom.  WASD: fly the drone.  Q/E: turn.  R/F: climb/descend.
Left click: the D-30s at Horenka.  1/2 or Tab: drone / the tower.  H: the drone's thermal.  P: pause.  [ ]: time.
5: out with an Igla team (again for the next).  Right button: shoulder it.  Left click: launch, on the steady tone.
Space: everyone out, back to Horenka.

Press Enter."#,
        op_label: "OBSERVERS, THE CONTROL TOWER (СПОСТЕРІГАЧІ, ДИСПЕТЧЕРСЬКА ВЕЖА)",
        op_lost: "The tower is hit. No eyes over the apron.",
        forward_belt: "the apron",
        plow_mine: "",
        mine_lines: [],
        registered: ("", "Bulava firing on the runway."),
        closing: [
            "The airlift that was to follow, eighteen Il-76s with the 76th Air Assault Division, turned back in the air.",
            "At dusk the army came back for the field (the counterattack, the next part).",
        ],
        keys: "R: the same morning again.     Esc: quit.",
        sources: [
            (publisher: "The Washington Post", date: "24 Aug 2022", title: "Battle for Kyiv: Ukrainian valor, Russian blunders combined to save the capital", url: "https://www.washingtonpost.com/national-security/interactive/2022/kyiv-battle-ukraine-survival/"),
            (publisher: "RUSI", date: "7 Nov 2022", title: "The Russian air war and Ukrainian requirements for air defence", url: "https://www.rusi.org/explore-our-research/publications/special-resources/russian-air-war-and-ukrainian-requirements-air-defence"),
            (publisher: "RUSI", date: "30 Nov 2022", title: "Preliminary lessons in conventional warfighting from Russia's invasion of Ukraine: February–July 2022", url: "https://www.rusi.org/explore-our-research/publications/special-resources/preliminary-lessons-conventional-warfighting-russias-invasion-ukraine-february-july-2022"),
            (publisher: "War on the Rocks", date: "10 Aug 2023", title: "The battle of Hostomel airport: a key moment in Russia's defeat in Kyiv", url: "https://warontherocks.com/the-battle-of-hostomel-airport-a-key-moment-in-russias-defeat-in-kyiv/"),
            (publisher: "The British Army Review", date: "Mar 2024", title: "The battle of Irpin River, February/March 2022", url: "https://chacr.org.uk/wp-content/uploads/2024/03/BAR-187-compressed.pdf"),
            (publisher: "Modern War Institute", date: "21 Feb 2025", title: "Urban Warfare Project case study #12: battle of Kyiv", url: "https://mwi.westpoint.edu/urban-warfare-project-case-study-12-battle-of-kyiv/"),
        ],
    ),
    // Over the apron, looking west at the runway.
    camera: (900.0, 450.0),
    observed_from: Home,

    // The National Guard's posts (c01 §3), each at the edge of what it holds, not inside it (the map's footprints are
    // solid): the hangar's west doors, the apron's north end by the fuel farm, the stands (OSM's parking positions
    // 6-7), the offices of the Antonov flight-test centre, and the base's gate by the railway crossing. Where the
    // radar stood the sources do not place; here it is at the runway's south end by stand 12 (an assumption, flagged
    // in design/hostomel.md), as are the control tower's place (the OSM has none) and so the observers'.
    ua_positions: [(915.0, 650.0), (700.0, 330.0), (800.0, 700.0), (955.0, 1075.0), (1250.0, 560.0), (520.0, 1000.0)],
    ru_positions: [],
    routes: [
        (line: "e373", deploy: (1030.0, -713.0), objective: (1600.0, 450.0)),
    ],
    // The column game's lines, out of the way until the areas replace them (phase 3).
    grey_zone: (4000.0, 4500.0),
    advance: 1.0,
    foothold_z: 9000.0,
    defence_z: 9000.0,
    home: (1450.0, 760.0),
    jam_z: 9000.0,
    mortar_band: (0.0, 0.0),

    // ---- The battle's part (bav_sim::data) ----
    // The National Guard's rear echelon (c01 §4): small arms, a few BTRs, Igla MANPADS, one ZU-23-2, and two D-30s
    // at Horenka. How many Iglas the sources do not say; here three teams of two missiles in the Record, more on the
    // table. (The BTRs come with their model: the BTR-3E, a BTR-80 hull.)
    catalog: [
        (id: "rifles", name: ("Rifle section", "Стрілецьке відділення"), what: Post(None), cost: 3, supply: 2, available: 8),
        (id: "igla", name: ("Igla team, 2 missiles", "Розрахунок «Ігли», 2 ракети"), what: Air(Igla(2)), cost: 7, supply: 6, available: 4),
        (id: "zu23", name: ("ZU-23-2", "ЗУ-23-2"), what: Air(Zu23(30)), cost: 7, supply: 5, available: 2),
    ],
    support: [
        (id: "d30", name: ("Two D-30s at Horenka, 20 rounds", "Два Д-30 у Горенці, 20 пострілів"), what: Shells(20), cost: 4, available: 4),
    ],
    // The Record: riflemen at the hangar and the offices; the Igla teams at the apron's north end, the stands and the
    // radar; the ZU-23-2 by the base's gate; forty rounds for the D-30s.
    allotment: (
        points: 60,
        record: [
            (id: "rifles", at: Some(0)), (id: "igla", at: Some(1)), (id: "igla", at: Some(2)), (id: "rifles", at: Some(3)),
            (id: "zu23", at: Some(4)), (id: "igla", at: Some(5)),
            (id: "d30", count: 2),
        ],
    ),
    old_wreck_kinds: [],
    // Space: everyone out, to Horenka (the decision the day turns on: leave too late and they are taken).
    space_key: Withdraw,
    shift_fire: Raam,
    registered_fire: (600.0, 0),
    // The fight for the field: the rear echelon's ammunition ran out after about two hours (c01 §2: "out of
    // ammunition, the defenders withdraw"); about thirty men to a post; out to the south-east, towards Horenka.
    fight: Some((
        ammo: 230,
        men_per: 5,
        // HUR claimed up to fifty VDV killed at Hostomel; the posts fire among hangars, aircraft and stands.
        rifles: 0.3,
        // The VDV had no armour and no guns: they worked forward slowly, post by post.
        assault: 0.03,
        out_to: (2350.0, 1850.0),
        zones: [
            (name: ("the hangar", "ангар"), poly: [(900.0, 520.0), (1090.0, 520.0), (1090.0, 720.0), (900.0, 720.0)]),
            (name: ("the apron", "перон"), poly: [(520.0, 220.0), (900.0, 220.0), (900.0, 780.0), (520.0, 780.0)]),
            (name: ("the tower", "вежа"), poly: [(780.0, 320.0), (900.0, 320.0), (900.0, 440.0), (780.0, 440.0)]),
            (name: ("the base", "база"), poly: [(1180.0, 520.0), (1820.0, 520.0), (1820.0, 1160.0), (1180.0, 1160.0)]),
            (name: ("the radar", "радар"), poly: [(440.0, 920.0), (600.0, 920.0), (600.0, 1080.0), (440.0, 1080.0)]),
        ],
    )),
    operator: (pos: (1450.0, 760.0), found_per_hour: 0.0),
    // The stream (c01 §2, §6 set piece 1): about 34 helicopters over the Dnipro, past the Kyiv dam (lost a Ka-52 and
    // a Mi-24 there, before the field), in at treetop height under the cloud from the east. Gunships first, circling
    // the field and working over what they see; the Mi-8s behind them, sixteen men each, onto the apron, the
    // taxiways and the runway's south end. Here: 10 Ka-52s, 8 Mi-24s, 16 Mi-8s (256 VDV), in four waves from about
    // 11:00. The men go for the hangar, the tower, the base's gate, the radar and the offices.
    script: [
        (2.0, Say("Bird up. Low cloud, drizzle. The hangars are still smoking from this morning's missiles.")),
        (12.0, Say("All, this is {command}. Helicopters over the Kyiv dam, coming up the river. Many of them. To your posts.")),
        (290.0, Say("This is {op}. Helicopters, east, low over the trees! Dozens!")),
        (300.0, Air([
            (kind: Ka52, from: (9000.0, 300.0), via: [(2600.0, 250.0)], at: (700.0, 500.0), goal: None, delay: 0.0),
            (kind: Ka52, from: (9000.0, 300.0), via: [(2600.0, 250.0)], at: (700.0, 500.0), goal: None, delay: 6.0),
            (kind: Ka52, from: (9000.0, 300.0), via: [(2600.0, 250.0)], at: (700.0, 500.0), goal: None, delay: 12.0),
            (kind: Ka52, from: (9000.0, 300.0), via: [(2600.0, 250.0)], at: (700.0, 500.0), goal: None, delay: 18.0),
            (kind: Mi24, from: (9000.0, 300.0), via: [(2600.0, 350.0)], at: (700.0, 500.0), goal: None, delay: 24.0),
            (kind: Mi24, from: (9000.0, 300.0), via: [(2600.0, 350.0)], at: (700.0, 500.0), goal: None, delay: 30.0),
        ])),
        (320.0, Air([
            (kind: Mi8, from: (9000.0, 300.0), via: [(2600.0, 200.0)], at: (600.0, 300.0), goal: Some((915.0, 650.0)), delay: 20.0),
            (kind: Mi8, from: (9000.0, 300.0), via: [(2600.0, 240.0)], at: (700.0, 450.0), goal: Some((840.0, 380.0)), delay: 25.0),
            (kind: Mi8, from: (9000.0, 300.0), via: [(2600.0, 280.0)], at: (560.0, 600.0), goal: Some((1250.0, 560.0)), delay: 30.0),
            (kind: Mi8, from: (9000.0, 300.0), via: [(2600.0, 320.0)], at: (450.0, 480.0), goal: Some((520.0, 1000.0)), delay: 35.0),
            (kind: Mi8, from: (9000.0, 300.0), via: [(2600.0, 360.0)], at: (780.0, 260.0), goal: Some((955.0, 1075.0)), delay: 40.0),
            (kind: Mi8, from: (9000.0, 300.0), via: [(2600.0, 400.0)], at: (660.0, 720.0), goal: Some((700.0, 330.0)), delay: 45.0),
        ])),
        (420.0, Air([
            (kind: Ka52, from: (8000.0, -2600.0), via: [(1800.0, -900.0)], at: (700.0, 500.0), goal: None, delay: 0.0),
            (kind: Ka52, from: (8000.0, -2600.0), via: [(1800.0, -900.0)], at: (700.0, 500.0), goal: None, delay: 6.0),
            (kind: Ka52, from: (8000.0, -2600.0), via: [(1800.0, -900.0)], at: (700.0, 500.0), goal: None, delay: 12.0),
            (kind: Mi24, from: (8000.0, -2600.0), via: [(1800.0, -800.0)], at: (700.0, 500.0), goal: None, delay: 18.0),
            (kind: Mi24, from: (8000.0, -2600.0), via: [(1800.0, -800.0)], at: (700.0, 500.0), goal: None, delay: 24.0),
            (kind: Mi24, from: (8000.0, -2600.0), via: [(1800.0, -800.0)], at: (700.0, 500.0), goal: None, delay: 30.0),
            (kind: Mi8, from: (8000.0, -2600.0), via: [(1600.0, -700.0)], at: (120.0, 560.0), goal: Some((1250.0, 560.0)), delay: 25.0),
            (kind: Mi8, from: (8000.0, -2600.0), via: [(1600.0, -670.0)], at: (30.0, 380.0), goal: Some((520.0, 1000.0)), delay: 30.0),
            (kind: Mi8, from: (8000.0, -2600.0), via: [(1600.0, -640.0)], at: (250.0, 720.0), goal: Some((955.0, 1075.0)), delay: 35.0),
            (kind: Mi8, from: (8000.0, -2600.0), via: [(1600.0, -610.0)], at: (-60.0, 200.0), goal: Some((700.0, 330.0)), delay: 40.0),
            (kind: Mi8, from: (8000.0, -2600.0), via: [(1600.0, -580.0)], at: (380.0, 860.0), goal: Some((915.0, 650.0)), delay: 45.0),
        ])),
        (540.0, Air([
            (kind: Ka52, from: (9000.0, 300.0), via: [(2600.0, 500.0)], at: (700.0, 500.0), goal: None, delay: 0.0),
            (kind: Ka52, from: (9000.0, 300.0), via: [(2600.0, 500.0)], at: (700.0, 500.0), goal: None, delay: 6.0),
            (kind: Ka52, from: (9000.0, 300.0), via: [(2600.0, 500.0)], at: (700.0, 500.0), goal: None, delay: 12.0),
            (kind: Mi24, from: (9000.0, 300.0), via: [(2600.0, 600.0)], at: (700.0, 500.0), goal: None, delay: 18.0),
            (kind: Mi24, from: (9000.0, 300.0), via: [(2600.0, 600.0)], at: (700.0, 500.0), goal: None, delay: 24.0),
            (kind: Mi24, from: (9000.0, 300.0), via: [(2600.0, 600.0)], at: (700.0, 500.0), goal: None, delay: 30.0),
            (kind: Mi8, from: (9000.0, 300.0), via: [(2600.0, 450.0)], at: (820.0, 820.0), goal: Some((955.0, 1075.0)), delay: 25.0),
            (kind: Mi8, from: (9000.0, 300.0), via: [(2600.0, 490.0)], at: (520.0, 960.0), goal: Some((700.0, 330.0)), delay: 30.0),
            (kind: Mi8, from: (9000.0, 300.0), via: [(2600.0, 530.0)], at: (900.0, 700.0), goal: Some((915.0, 650.0)), delay: 35.0),
            (kind: Mi8, from: (9000.0, 300.0), via: [(2600.0, 570.0)], at: (640.0, 1000.0), goal: Some((840.0, 380.0)), delay: 40.0),
            (kind: Mi8, from: (9000.0, 300.0), via: [(2600.0, 610.0)], at: (300.0, 300.0), goal: Some((1250.0, 560.0)), delay: 45.0),
        ])),
        // The airlift (c01 §2, §7): eighteen Il-76s with the 76th Division, to land once the runway was taken. They
        // were turned back in the air that day.
        (1250.0, Airlift(4)),
        // Out of ammunition, the defenders withdraw (c01 §2, about 13:00; here earlier, as the posts are worn down
        // sooner): the Record's order. In Command it is yours.
        (950.0, PullOut),
    ],
)
