// Myrnohrad, part I, The fog (Туман): 10 November 2025, morning. Fog on the towns from first light until it lifts
// before noon (ERA5, c15 §3: near-saturated air and 6-10 hours of fog on 5-7, 10 and 12 November), and under it
// their infantry walks in by twos and threes, thirty to forty a day in such weather (c15 §5). Until their drones and
// the vehicle run are built (design/myrnohrad.md, phases 3-7), the day is a placeholder: the seep from four sides at
// the fog's rate, the posts, two KAB pairs. The schema is bav_core::data and bav_sim::data; the map is
// map.ron.
(
    date: "10 November 2025",
    tally_date: "10 NOV 2025",
    // 06:30 to about 12:30 in the day's 1500 s.
    day_start_min: 390.0,
    compression: 0.24,
    season: Autumn,
    // 10 November is the 314th day of the year; Kyiv on UTC+2.
    sun: (314, 2.0),
    // Overcast all day, the air near saturation until mid-morning, a light southerly wind (ERA5 for 10 November:
    // humidity 97-98% to 08:00, 83% by 10:00; wind 3-10 km/h from the south).
    overcast: true,
    wind: (0.8, 0.0, -1.0),
    // The fog, drawn and seen through alike (bav_sim::fight::Seeing): a few hundred metres until mid-morning,
    // thinning from 10:00, gone by 11:20. The net warns of the lift twenty minutes ahead.
    fog: [(390.0, 250.0), (540.0, 300.0), (600.0, 700.0), (650.0, 3000.0), (680.0, 6000.0)],
    // The town after five months of it: a third of the roofs gone, a dozen ruins smouldering, a few cars caught on
    // the road.
    ruined: (0.35, 11),
    smouldering: 12,
    cars: [
        ((-1445.8, -213.4), 1.28),
        ((-2102.3, -382.4), 1.61),
        ((-517.5, -89.7), 2.04),
        ((721.8, -313.2), -1.4),
        ((-1577.9, -236.6), -1.4),
        ((428.1, -297.3), -1.31),
        ((-614.5, -94.7), -1.76),
        ((332.8, -285.0), -1.69),
    ],
    words: (
        briefing: r#"MYRNOHRAD (МИРНОГРАД), THE ROAD INTO THE POCKET
10 NOVEMBER 2025, MORNING

Myrnohrad is a mining town of 46,000 people, seven kilometres east of Pokrovsk: headframes and spoil heaps,
nine-storey blocks and streets of private houses. By November the Russians are on three sides of it. One road
comes in from the west, past the villages of Rivne and Svitle, and their drones watch every metre of it.

You are a drone team of the town's garrison, in a basement in the western quarters, with a thermal Mavic, a few
FPVs, grenades to drop, and a gun battery's rounds when there are any. Riflemen hold the villages, the western
quarters and the Tsentralna mine.

This morning there is fog. Under it nothing flies well, theirs or ours, and their infantry walks in by twos and
threes: ten a day in sun, thirty or forty in weather like this. When it lifts, anything still on the road is seen.

The day will run whether or not you do anything. What you do matters at the margin.

Mouse: right-drag to look, wheel to zoom.  WASD: fly the drone.  Q/E: turn.  R/F: climb/descend.  I: thermal.
Left click: 155 mm fire mission (4 rounds).  4: an FPV.  C: drop a grenade from the drone.
V: a ground robot for the wounded.  Alt+click: a robot with ammunition.  7: the robot's camera.
1/2 or Tab: drone / the observers on the high-rise.  M: move the drone team when they find you.  P: pause.  [ ]: time.

Press Enter."#,
        op_label: "OBSERVERS, A NINE-STOREY ROOF ON SOBORNA STREET (СПОСТЕРІГАЧІ, ДЕВ'ЯТИПОВЕРХІВКА НА СОБОРНІЙ)",
        op_lost: "The observers on the high-rise are gone. No eyes from the roof.",
        forward_belt: "the ruins",
        mine_lines: ["Mine. He's stopped.", "Another one on a mine.", "Mine on the verge. That one's done."],
        closing: [
            "More than 300 Russians got into Pokrovsk under that week's fog.",
            "On 14 November they raised a flag on a ruined mine on Myrnohrad's south-eastern edge. It was down within the day.",
        ],
        keys: "R: the same morning again, in the same fog.     Esc: quit.",
        sources: [
            (
                publisher: "BBC",
                date: "Nov 2025",
                title: "Pokrovsk: Russian forces use fog cover to push further into key Ukraine town",
                url: "https://www.bbc.com/news/articles/cx276px3280o",
            ),
            (
                publisher: "Hromadske",
                date: "Nov 2025",
                title: "Is there a risk of encirclement in Pokrovsk and what awaits Myrnohrad? Soldiers explain",
                url: "https://hromadske.ua/en/war/254005-ti-khto-v-pokrovsku-na-peredovykh-pozytsiiakh-vze-v-pryntsypi-v-otochenni-z-iakoho-malo-shansiv-vyyty",
            ),
            (
                publisher: "Euromaidan Press",
                date: "15 Nov 2025",
                title: "Russia's Pokrovsk twin city strategy: can't capture it, so plant flag on ruined mine, die, let Ukraine remove it",
                url: "https://euromaidanpress.com/2025/11/15/russias-pokrovsk-twin-city-strategy-cant-capture-it-so-plant-flag-on-ruined-mine-die-let-ukraine-remove-it-video/",
            ),
            (
                publisher: "Open-Meteo (ECMWF ERA5 reanalysis)",
                date: "2026",
                title: "Historical weather, Pokrovsk, July 2025 – February 2026",
                url: "https://archive-api.open-meteo.com/v1/archive?latitude=48.28&longitude=37.18&start_date=2025-07-15&end_date=2026-02-28&daily=temperature_2m_max,temperature_2m_min,precipitation_sum,snowfall_sum,snow_depth_max,cloud_cover_mean,relative_humidity_2m_mean,wind_speed_10m_max,sunrise,sunset&hourly=relative_humidity_2m,wind_speed_10m,cloud_cover_low&timezone=Europe%2FKyiv",
            ),
        ],
    ),
    // The debrief's rows (the schema is the game's screen.rs); the tally's and the fire panel's lines are map.ron's.
    debrief: (
        rows: [
            Line("Their men sent in", Sent),
            Line("    dead", AttackerDead),
            Line("    came back", Returned),
            Line("Our casualties", DefenderLosses),
            Areas("{area} at the end"),
            Line("Shells left", Shells),
            If(Drops, [Line("Grenades dropped from the drone", Drops)]),
            If(
                Seep,
                [
                    Line("Their burrows in the town", Burrows),
                    Line("    found", BurrowsFound),
                    Line("    emptied", BurrowsEmptied),
                    Line("Their fire on our drone crew told", CrewsHit),
                ],
            ),
            If(
                Robots,
                [
                    Line("Ground robots", Robots),
                    Line("    loads delivered", Delivered),
                    Line("Wounded brought out by robot", WoundedCarried),
                    Line("    still waiting", WoundedWaiting),
                ],
            ),
            If(Bomber, [Line("The Vampire's sorties", Sorties)]),
        ],
    ),
    // The observers on the roof of a nine-storey block on Soborna street.
    op: ((868.0, 495.0), 30.0),

    // The pocket on 10 November (c15 §3: the gap between the pincers about 3 km on 29 October, about 1 km by late
    // November, both north of the box): theirs beyond the south-eastern edge and Pokrovsk's fields to the south-west,
    // and the Krasnyi Lyman jaw at the north-eastern corner; the grey zone a few hundred metres in from both.
    pocket: (
        grey: [
            [
                (-5000.0, -350.0),
                (-2700.0, -300.0),
                (-1800.0, 250.0),
                (-500.0, 900.0),
                (800.0, 1050.0),
                (2000.0, 1100.0),
                (5000.0, 1100.0),
                (5000.0, 5000.0),
                (-5000.0, 5000.0),
            ],
            [(1300.0, -5000.0), (5000.0, -5000.0), (5000.0, -600.0), (1900.0, -850.0)],
        ],
        theirs: [
            [
                (-5000.0, -150.0),
                (-2700.0, -100.0),
                (-2000.0, 550.0),
                (-600.0, 1300.0),
                (2000.0, 1500.0),
                (5000.0, 1500.0),
                (5000.0, 5000.0),
                (-5000.0, 5000.0),
            ],
            [(1700.0, -5000.0), (5000.0, -5000.0), (5000.0, -1000.0), (2200.0, -1300.0)],
        ],
    ),
    // The garrison's posts: Svitle's south edge, Rivne, the western quarters' west and south, the high-rise on
    // Soborna, the Tsentralna mine, the south-eastern edge, and the town's western entrance on the H-32.
    ua_positions: [
        (-560.0, -1250.0),
        (-1750.0, -700.0),
        (-100.0, 250.0),
        (500.0, 600.0),
        (880.0, 525.0),
        (1400.0, -300.0),
        (1150.0, 1000.0),
        (300.0, -150.0),
    ],

    // ---- The battle's part (bav_sim::data) ----
    // The garrison's ground robots (c15 §5: ammunition, food and fuel in, the wounded out; the Zmiy's link lost for
    // 1.5 hours; robots stuck in craters). Three for the morning; the wounded wait for one. Their FPVs on the road
    // are a chance per kilometre until their drone crews are built (design/myrnohrad.md, phase 3), and small under
    // the fog.
    robots: (ugvs: 3, casevac: true, found_per_km: 0.1),
    // The Record: riflemen at the eight posts, a battery's sixteen rounds, four FPVs (the light ones useless in the
    // wet, c15 §3), six grenades for the drone.
    allotment: (
        points: 80,
        supply: (6, 1.0),
        record: [
            (id: "rifles", at: 0),
            (id: "rifles", at: 1),
            (id: "rifles", at: 2),
            (id: "rifles", at: 3),
            (id: "rifles", at: 4),
            (id: "rifles", at: 5),
            (id: "rifles", at: 6),
            (id: "rifles", at: 7),
            (id: "155", count: 1),
            (id: "fpv", count: 4),
            (id: "vog", count: 3),
        ],
    ),
    // Their drones over the road (bav_sim::killzone; c15 §4, §5). Sudny Den's radio FPVs from Pokrovsk's side and the
    // "Irish" (Grom-Kaskad) from the Krasnyi Lyman jaw are grounded while the fog is under 500 m; the Archangels' fibre
    // ones fly, worse, and their waiters sit on the shoulders of both roads in. Rubikon comes onto the road with the
    // lift. The garrison has one EW dome, at the town's western entrance over the drone team, and nets over
    // a kilometre of the H-32 from Rivne to the town (the run-in's procedure, c15 §5). Three runs from the road head: a Lada in
    // the fog under the nets, a pickup by the northern road that is still out when the fog goes, and a Lada after the
    // lift. The rates are the design's: the dossier gives none for the box (c15 §11).
    killzone: (
        crews: [
            (
                name: ("Rubikon", "Рубікон"),
                kind: Fibre,
                at: (600.0, 2900.0),
                per_hour: 14.0,
                arrives: 980.0,
                budget: 12,
            ),
            // The radio crews fly through relays on masts on their ground, inside the box (phase 6).
            (
                name: ("Sudny Den", "Судний день"),
                kind: Rf,
                at: (-900.0, 2600.0),
                per_hour: 10.0,
                relay: (-700.0, 1620.0),
            ),
            (
                name: ("the Irish", "«Ірландці»"),
                kind: Rf,
                at: (2800.0, -2300.0),
                per_hour: 8.0,
                relay: (2250.0, -1650.0),
            ),
            (name: ("the Archangels", "«Архангели»"), kind: Fibre, at: (2700.0, 2200.0), per_hour: 6.0),
            (name: ("the Archangels", "«Архангели»"), kind: Waiter, at: (-1240.0, -162.0), per_hour: 2.0),
            (name: ("the Archangels", "«Архангели»"), kind: Waiter, at: (-560.0, -86.0), per_hour: 2.0),
            (name: ("the Archangels", "«Архангели»"), kind: Waiter, at: (-1100.0, 392.0), per_hour: 2.0),
        ],
        // The H-32 from the road head into the town, and the northern road by Rivne's north.
        watch: [
            [
                (-2304.0, -448.5),
                (-1795.4, -302.3),
                (-1573.0, -240.2),
                (-1240.7, -150.3),
                (-779.5, -83.9),
                (-415.7, -105.0),
                (-199.3, -202.5),
                (14.4, -247.8),
                (628.6, -368.4),
                (1076.7, -414.0),
            ],
            [(-2304.0, 35.6), (-1218.6, 367.3), (-1003.4, 384.6), (-833.1, 332.8), (-674.8, 212.8), (-437.9, -80.9)],
        ],
        domes: [(post: 7, radius: 300.0)],
        nets: [[(-1573.0, -240.2), (-1240.7, -150.3), (-779.5, -83.9), (-718.8, -82.4), (-415.7, -105.0)]],
        runs: [
            (
                at: 150.0,
                kind: Lada,
                way: [
                    (-2290.0, -444.0),
                    (-1795.4, -302.3),
                    (-1573.0, -240.2),
                    (-1240.7, -150.3),
                    (-779.5, -83.9),
                    (-718.8, -82.4),
                    (-415.7, -105.0),
                    (-331.9, -132.8),
                    (-199.3, -202.5),
                    (-118.7, -227.9),
                    (14.4, -247.8),
                    (137.3, -262.4),
                ],
                back: 120.0,
            ),
            (
                at: 640.0,
                kind: L200,
                way: [
                    (-2304.0, 35.6), (-1218.6, 367.3), (-1130.6, 385.6), (-1003.4, 384.6), (-908.0, 363.0),
                    (-833.1, 332.8), (-741.2, 275.4), (-674.8, 212.8), (-437.9, -80.9), (-415.7, -105.0),
                    (-331.9, -132.8), (-199.3, -202.5), (-118.7, -227.9), (14.4, -247.8), (137.3, -262.4),
                ],
                back: 200.0,
            ),
            (
                at: 1080.0,
                kind: Lada,
                way: [
                    (-2290.0, -444.0),
                    (-1795.4, -302.3),
                    (-1573.0, -240.2),
                    (-1240.7, -150.3),
                    (-779.5, -83.9),
                    (-718.8, -82.4),
                    (-415.7, -105.0),
                    (-331.9, -132.8),
                    (-199.3, -202.5),
                    (-118.7, -227.9),
                    (14.4, -247.8),
                    (137.3, -262.4),
                ],
            ),
        ],
        // Their direction-finders locate our drone team's ground station about once an hour of drone time.
        team: 1.0,
        // After the lift (placeholders for phase 7): a 155 mm mission on Sudny Den's launch point, and an FPV of ours
        // on the Irish's relay; a point hit is out for an hour of the clock (c15 §5, §10: a lever, not a win).
        strikes: [(at: 1180.0, crew: 1, by: Guns), (at: 1300.0, crew: 2, by: Fpv, relay: true)],
    ),
    // Their reconnaissance wings and our interceptors (bav_sim::wings; 01 e7, e9). After the lift an Orlan comes over
    // the road from Pokrovsk's side and a ZALA from the jaw; the drone team has three interceptors and a radar that
    // cues them. Placeholders for phase 7.
    wings: (
        passes: [
            (
                at: 1030.0,
                kind: Orlan,
                path: [(-200.0, 5200.0), (-700.0, 300.0), (-1700.0, -500.0), (-1300.0, 5200.0)],
            ),
            (
                at: 1260.0,
                kind: Zala,
                path: [(2900.0, -3200.0), (1200.0, -600.0), (-200.0, -300.0), (2500.0, -3600.0)],
                agl: 500.0,
            ),
        ],
        interceptors: 3,
        radar: (at: (450.0, -60.0), range: 2000.0),
    ),
    // The morning: twos and threes seeping in from four sides under the fog (bav_sim::seep), about three men an hour
    // in clear air and three and a half times that in the thick of it, so thirty-odd by noon (c15 §5); most go for
    // the drone crew in the western quarters. KABs on the town; the fog lifting before noon.
    script: [
        (2.0, Say("Bird up. Fog on everything. I can see the road for a hundred metres, no more.")),
        (20.0, Say("All, this is {command}. They walk in this weather. Watch the belts and the ruins.")),
        // Placeholder runs (the part's content is phase 7): ammunition to Rivne under the fog, food to Svitle.
        (90.0, Ugv(to: 1, cargo: Ammo)),
        (420.0, Ugv(to: 0, cargo: Food)),
        (
            60.0,
            Seep(
                route: 0,
                from: 450.0,
                width: 300.0,
                per_hour: 1.0,
                crews: 0.6,
                label: "06:45  Twos and threes from the south-eastern edge",
            ),
        ),
        (
            120.0,
            Seep(
                route: 1,
                from: 700.0,
                width: 300.0,
                per_hour: 0.7,
                crews: 0.4,
                label: "07:00  From the Krasnyi Lyman side",
            ),
        ),
        (200.0, Seep(route: 2, from: 1550.0, width: 300.0, per_hour: 0.55, crews: 0.15)),
        (260.0, Seep(route: 3, from: 1000.0, width: 300.0, per_hour: 0.7, crews: 0.15)),
        (
            400.0,
            Bombs(
                from: (600.0, 200.0),
                to: (800.0, 350.0),
                n: 2,
                label: "08:05  KABs on the western quarters",
                say: "Su-34s. Glide bombs on the town. Down.",
            ),
        ),
        (900.0, Bombs(from: (-650.0, -1350.0), to: (-450.0, -1250.0), n: 2, label: "", say: "KABs on Svitle.")),
        (1000.0, Say("This is {op}. The fog is thinning. I can see the heap.")),
        (1150.0, Say("Bird: it's clear. Everything on the road is seen now. Nothing moves on wheels till dark.")),
    ],
)
