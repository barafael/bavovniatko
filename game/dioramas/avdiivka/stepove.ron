        (At((1083.7, -118.7)), -0.44),
        (At((-309.2, 1239.7)), 0.26),
        (At((-373.5, 1085.4)), -0.05),
        (At((-315.1, 945.6)), 0.39),
        (At((-335.4, 870.5)), -0.43),
        (At((-401.0, 755.9)), -0.35),
        (At((-407.4, 684.4)), -0.28),
        (At((-388.6, 542.3)), -0.07),
        (At((-373.1, 461.5)), -0.13),
        (At((-374.2, 295.1)), 0.12),
        (At((-438.6, 159.5)), -0.4),
    ],
    // Overcast, light snow (ERA5, v02 §3).
    overcast: true,
    wind: (-2.0, 0.0, 1.5),

    // ---- The battle's part (bav_sim::data) ----
    // The 47th's and the 110th's side as Units and Support: Stugna and Javelin teams and rifle sections for the
    // positions, a tank and the Bradleys for the hides, and the 55th's guns with a working day's rounds. The ATGM teams
    // are Command's to buy; the Record fields none. FPVs were a daily stock by this autumn (arcs.md §6).
    catalog: [
        (
            id: "stugna",
            name: ("Stugna-P team", "Розрахунок «Стугни-П»"),
            what: Post(Stugna),
            cost: 8,
            supply: 5,
            available: 5,
        ),
        (
            id: "javelin",
            name: ("Javelin team", "Розрахунок «Джавеліна»"),
            what: Post(Javelin),
            cost: 9,
            supply: 5,
            available: 4,
        ),
        (
            id: "rifles",
            name: ("Rifle section", "Стрілецьке відділення"),
            what: Post(None),
            cost: 3,
            supply: 2,
            available: 9,
        ),
        (id: "tank", name: ("Tank in a hide", "Танк у капонірі"), what: Hide, cost: 10, supply: 6, available: 3),
        // The 47th's Bradleys hull-down at the hides, a gunner's seat the player can take (key 6).
        (
            id: "m2",
            name: ("Bradley in a hide", "«Бредлі» у капонірі"),
            what: Dug(Bradley),
            cost: 9,
            supply: 6,
            available: 4,
        ),
        (id: "bradley", name: ("Bradley", "«Бредлі»"), what: Vehicle(Bradley), cost: 7, supply: 6, available: 6),
        (id: "mtlb", name: ("MT-LB", "МТ-ЛБ"), what: Vehicle(Mtlb), cost: 4, supply: 4, available: 3),
    ],
    support: [
        (id: "155", name: ("155 mm, 16 rounds", "155 мм, 16 пострілів"), what: Shells(16), cost: 4, available: 10),
        (id: "raam", name: ("RAAM mission", "Дистанційне мінування (RAAM)"), what: Raam, cost: 3, available: 6),
        (id: "himars", name: ("HIMARS mission", "Удар HIMARS"), what: Himars, cost: 8, available: 2),
        (
            id: "brigade",
            name: ("Brigade guns, 20 rounds", "Бригадна артилерія, 20 пострілів"),
            what: Brigade(20),
            cost: 2,
            available: 10,
        ),
        (
            id: "mortar",
            name: ("120 mm mortars, 20 bombs", "Міномети 120 мм, 20 мін"),
            what: Mortar(20),
            cost: 1,
            available: 10,
        ),
        (id: "fpv", name: ("FPV strike drone", "FPV-дрон"), what: Fpv, cost: 2, available: 6),
        (id: "mavic", name: ("Two more Mavic 3s", "Ще два Mavic 3"), what: Mavic(2), cost: 3, available: 2),
    ],
    // The Record: riflemen in all nine positions (the trench, the heap, the plant's corner, the railway), two Bradleys
    // and a tank in the village's hides, 96 rounds, three RAAM missions, one HIMARS, two FPVs. No ATGM teams and no
    // cluster that afternoon: the Bradleys' gun was the answer.
    allotment: (
        points: 180,
        supply: (12, 2.0),
        record: [
            // The trench under the tank's fire is riflemen's; the answer that afternoon was the Bradleys' gun.
            (id: "rifles", at: 0),
            (id: "rifles", at: 1),
            (id: "rifles", at: 2),
            (id: "rifles", at: 3),
            (id: "rifles", at: 4),
            (id: "rifles", at: 5),
            (id: "rifles", at: 6),
            (id: "rifles", at: 7),
            (id: "rifles", at: 8),
            (id: "m2", at: 9),
            (id: "m2", at: 10),
            (id: "tank", at: 11),
            (id: "155", count: 6),
            (id: "raam", count: 3),
            (id: "himars", count: 1),
            (id: "brigade", count: 6),
            (id: "mortar", count: 6),
            (id: "fpv", count: 2),
        ],
    ),
    old_wreck_kinds: [T72, Bmp2, Bmp1, Mtlb, T80, Bmp2, Bmp2, T72, Bmp1, Bmp2, Mtlb, T72],
    space_key: Atgm,
    shift_fire: Raam,
    // Their guns work the village, the railway and the heap all day, and the ground behind.
    ru_guns: Posts(x: (-1800.0, 1800.0), band: (-1300.0, -600.0)),
    registered_fire: (50.0, 6),
    // Their EW: jammers with the columns' start lines, the rear emitters past the heap's far foot.
    ew: (jammers: [(1300.0, 1700.0), (-900.0, 1750.0)], radius: 900.0, depth: 700.0),
    // FPVs by the day, five minutes in the air.
    fpv: (endurance: 300.0),
    // The launchers empty that afternoon (the experts' question, v02 §7: "unless they were out"), and the fight at
    // the village's own ranges: it was the 25 mm that did it.
    bradley: (tows: 0, range: 700.0),
    // Command's Enemy staff: Lancets for the Bradleys and the tank; Orlans over the village every few minutes.
    staff: (lancets: 3, orlan: (150.0, 300.0)),
    // The drone team behind the village. By October 2023 the Russians found a Mavic pilot less often than in
    // February, but still.
    operator: (pos: (900.0, -1400.0), found_per_hour: 0.2),

    // The day (c11 §2, §6 set piece 1): the fire preparation before dawn, then four columns of 15-22 across the
    // open field, two on Stepove and two on the heap and the railway, with infantry on foot behind them; about 70
    // vehicles on the shoulder (the geolocated count for the whole salient that day).
    script: [
        (2.0, Say("Bird up. Snow, cloud down on the field. Nothing moving yet.")),
        (60.0, Say("This is {op}. Smoke on the east end. Something behind it.")),
        (
            90.0,
            Column(
                route: 0,
                kinds: [T90m, Bmp2, Bmp2],
                plow: false,
                start: 1400.0,
                smoke: 2,
                label: "14:08  A tank and two BMPs into the east end",
            ),
        ),
        (100.0, Infantry(route: 0, groups: 2, size: 6, every: 20.0)),
        (110.0, Say("Bird: a T-90 in the village. He's firing on the trench.")),
    ],
)
