// Avdiivka's forces and the screen's lines, the same in all three parts (wave1.ron, wave2.ron, stepove.ron): the
// 47th's callsigns, the drone's thermal channel, Space and the ATGM teams, the tally and the fire panel, their guns
// and their EW, the FPVs, and where the drone team flies from. Merged before each part's own file, after the map
// (dioramas/index.ron); a field is here or in the part, never both.
(
    attacker: Ru,
    // The 47th flew thermal Mavics by then: key I.
    thermal: true,
    // Fictional, the 47th's: the player (a sighthound), the 55th's guns (anvil), the observers on the heap (crest),
    // the battalion's command post (flint).
    callsigns: (
        player: ("Khort", "Хорт"),
        guns: ("Kovadlo", "Ковадло"),
        op: ("Hrebin", "Гребінь"),
        command: ("Kremin", "Кремінь"),
    ),
    // The screen in the place's words (the schema is the game's screen.rs): the tally under the clock and what is
    // left to fire, `{name}` a figure the HUD fills in (the debrief's rows are each part's).
    hud: (
        tally: "{date}   {clock}\nRussian vehicles committed {committed}   knocked out {out}   withdrew {withdrawn}\nmen sent {sent}   came back {returned}{air}\n{zones}",
        stock: "155 mm  {shells} rds   DPICM  {cluster}   RAAM  {raam}   HIMARS  {himars}   FPV  {fpv}{vog}\nATGM teams {teams} ({missiles} missiles)   [{atgm_mode}]{speed}",
    ),
    space_key: Atgm,
    // Their guns work the village, the railway and the heap all day, and the ground behind.
    ru_guns: Posts(x: (-1800.0, 1800.0), band: (-1300.0, -600.0)),
    registered_fire: (50.0, 6),
    // Their EW: jammers with the columns' start lines, the rear emitters past the heap's far foot.
    ew: (jammers: [(1300.0, 1700.0), (-900.0, 1750.0)], radius: 900.0, depth: 700.0),
    // FPVs by the day, five minutes in the air.
    fpv: (endurance: 300.0),
    // The drone team behind the village. By October 2023 the Russians found a Mavic pilot less often than in
    // February, but still.
    operator: (pos: (900.0, -1400.0), found_per_hour: 0.2),
)
