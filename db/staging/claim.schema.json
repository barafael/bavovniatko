{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "bavovniatko staging record",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "local_id",
        "passage",
        "text",
        "kind",
        "epistemic",
        "cites"
      ],
      "properties": {
        "type": {
          "const": "claim"
        },
        "local_id": {
          "type": "string",
          "pattern": "^(?:\\d\\d|[cv]\\d\\d)-\\d{4}-\\d{2,3}$"
        },
        "passage": {
          "type": "string",
          "pattern": "^(?:\\d\\d|[cv]\\d\\d)/\\d{4}$"
        },
        "text": {
          "type": "string",
          "minLength": 8,
          "maxLength": 800
        },
        "kind": {
          "enum": [
            "fact",
            "figure",
            "event",
            "assessment",
            "forecast",
            "definition"
          ]
        },
        "epistemic": {
          "enum": [
            "observed",
            "reported",
            "claimed",
            "estimated",
            "derived",
            "computed"
          ]
        },
        "status": {
          "enum": [
            "active",
            "disputed"
          ]
        },
        "claimants": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "kind"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 2
              },
              "kind": {
                "enum": [
                  "person",
                  "outlet",
                  "think_tank",
                  "government_body",
                  "armed_force",
                  "military_unit",
                  "intelligence_agency",
                  "company",
                  "game_studio",
                  "ngo",
                  "academic_institution",
                  "international_org",
                  "platform",
                  "political_party",
                  "organisation"
                ]
              },
              "side": {
                "enum": [
                  "ua",
                  "ru",
                  "western",
                  "international",
                  "other"
                ]
              },
              "role": {
                "enum": [
                  "claimant",
                  "estimator",
                  "reporter",
                  "analyst"
                ]
              },
              "said_at": {
                "type": "string",
                "pattern": "^\\d{4}(-\\d{2}(-\\d{2})?)?$"
              }
            }
          }
        },
        "cites": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "source"
            ],
            "properties": {
              "source": {
                "type": "string"
              },
              "locator": {
                "type": "string"
              },
              "quote": {
                "type": "string",
                "maxLength": 400
              },
              "support": {
                "enum": [
                  "direct",
                  "secondary",
                  "background"
                ]
              }
            }
          }
        },
        "time": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "from",
            "precision"
          ],
          "properties": {
            "from": {
              "type": "string",
              "pattern": "^\\d{4}(-\\d{2}(-\\d{2})?)?$"
            },
            "to": {
              "type": "string",
              "pattern": "^\\d{4}(-\\d{2}(-\\d{2})?)?$"
            },
            "precision": {
              "enum": [
                "day",
                "month",
                "quarter",
                "year"
              ]
            }
          }
        },
        "eras": {
          "type": "array",
          "items": {
            "enum": [
              "e1",
              "e2",
              "e3",
              "e4",
              "e5",
              "e6",
              "e6a",
              "e6b",
              "e7",
              "e8",
              "e8a",
              "e8b",
              "e9",
              "e9a",
              "e9b"
            ]
          },
          "uniqueItems": true
        },
        "sides": {
          "type": "array",
          "items": {
            "enum": [
              "ua",
              "ru",
              "western",
              "other"
            ]
          },
          "uniqueItems": true
        },
        "mentions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "type"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 2
              },
              "type": {
                "enum": [
                  "place",
                  "event",
                  "system",
                  "actor",
                  "metric",
                  "work"
                ]
              },
              "kind": {
                "type": "string"
              },
              "role": {
                "enum": [
                  "subject",
                  "location",
                  "instrument",
                  "target",
                  "measure",
                  "mention"
                ]
              }
            }
          }
        },
        "observations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "metric",
              "unit",
              "value_text"
            ],
            "properties": {
              "metric": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*$"
              },
              "metric_new": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "label",
                  "dimension"
                ],
                "properties": {
                  "label": {
                    "type": "string"
                  },
                  "dimension": {
                    "type": "string"
                  }
                }
              },
              "value": {
                "type": "number"
              },
              "low": {
                "type": "number"
              },
              "high": {
                "type": "number"
              },
              "value_text": {
                "type": "string",
                "minLength": 1
              },
              "qualifier": {
                "enum": [
                  "exact",
                  "approx",
                  "at_least",
                  "at_most",
                  "range"
                ]
              },
              "unit": {
                "enum": [
                  "count",
                  "count_per_day",
                  "count_per_week",
                  "count_per_month",
                  "count_per_year",
                  "people",
                  "m",
                  "km",
                  "km2",
                  "ha",
                  "km2_per_month",
                  "km2_per_day",
                  "km2_per_year",
                  "km_per_km2",
                  "per_100km2",
                  "per_km2",
                  "percent",
                  "ratio",
                  "km_per_h",
                  "s",
                  "min",
                  "h",
                  "day",
                  "month",
                  "year",
                  "kg",
                  "t",
                  "usd",
                  "eur",
                  "uah",
                  "yuan",
                  "usd_bn",
                  "eur_bn",
                  "rounds_per_day",
                  "casualties_per_km2",
                  "degree",
                  "other",
                  "points",
                  "usd_m",
                  "uah_bn",
                  "km_per_day",
                  "people_per_day",
                  "m_per_s",
                  "km2_per_week",
                  "m2",
                  "celsius",
                  "litre",
                  "mhz",
                  "ghz",
                  "cny_per_km",
                  "rub",
                  "fps",
                  "per_km",
                  "km_per_year",
                  "mm",
                  "cm",
                  "knot",
                  "nmi",
                  "hour_of_day"
                ]
              },
              "time": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "from",
                  "precision"
                ],
                "properties": {
                  "from": {
                    "type": "string",
                    "pattern": "^\\d{4}(-\\d{2}(-\\d{2})?)?$"
                  },
                  "to": {
                    "type": "string",
                    "pattern": "^\\d{4}(-\\d{2}(-\\d{2})?)?$"
                  },
                  "precision": {
                    "enum": [
                      "day",
                      "month",
                      "quarter",
                      "year"
                    ]
                  }
                }
              },
              "side": {
                "enum": [
                  "ua",
                  "ru",
                  "western",
                  "other"
                ]
              },
              "place": {
                "type": "string"
              },
              "subject": {
                "type": "string"
              },
              "method": {
                "enum": [
                  "reported",
                  "estimated",
                  "derived",
                  "computed"
                ]
              },
              "note": {
                "type": "string"
              }
            }
          }
        },
        "notes": {
          "type": "string"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "local_id",
        "counter",
        "measure",
        "rationale",
        "evidence"
      ],
      "properties": {
        "type": {
          "const": "counter"
        },
        "local_id": {
          "type": "string",
          "pattern": "^(?:\\d\\d|[cv]\\d\\d)-x\\d{2,3}$"
        },
        "counter": {
          "type": "string"
        },
        "counter_kind": {
          "enum": [
            "recon_drone",
            "fpv_drone",
            "bomber_drone",
            "loitering_munition",
            "long_range_drone",
            "interceptor_drone",
            "ugv",
            "naval_drone",
            "drone_component",
            "tube_artillery",
            "rocket_artillery",
            "glide_bomb",
            "missile",
            "air_defence",
            "aircraft",
            "helicopter",
            "armour",
            "vehicle",
            "ew_system",
            "gnss_countermeasure",
            "passive_defence",
            "c2_software",
            "communications",
            "sensor",
            "mine",
            "fortification",
            "munition",
            "small_arms",
            "technique",
            "programme",
            "training_sim",
            "ship",
            "satellite"
          ]
        },
        "measure": {
          "type": "string"
        },
        "measure_kind": {
          "enum": [
            "recon_drone",
            "fpv_drone",
            "bomber_drone",
            "loitering_munition",
            "long_range_drone",
            "interceptor_drone",
            "ugv",
            "naval_drone",
            "drone_component",
            "tube_artillery",
            "rocket_artillery",
            "glide_bomb",
            "missile",
            "air_defence",
            "aircraft",
            "helicopter",
            "armour",
            "vehicle",
            "ew_system",
            "gnss_countermeasure",
            "passive_defence",
            "c2_software",
            "communications",
            "sensor",
            "mine",
            "fortification",
            "munition",
            "small_arms",
            "technique",
            "programme",
            "training_sim",
            "ship",
            "satellite"
          ]
        },
        "first_observed": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "from",
            "precision"
          ],
          "properties": {
            "from": {
              "type": "string",
              "pattern": "^\\d{4}(-\\d{2}(-\\d{2})?)?$"
            },
            "to": {
              "type": "string",
              "pattern": "^\\d{4}(-\\d{2}(-\\d{2})?)?$"
            },
            "precision": {
              "enum": [
                "day",
                "month",
                "quarter",
                "year"
              ]
            }
          }
        },
        "lag_days": {
          "type": "integer",
          "minimum": 0
        },
        "effect": {
          "type": "string"
        },
        "rationale": {
          "type": "string"
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^(?:\\d\\d|[cv]\\d\\d)-\\d{4}-\\d{2,3}$"
          }
        }
      }
    }
  ]
}
