UPDATE claim:cc11_0018_14 SET text = string::replace(text, "sunrise was about 07:35 and sunset about 17:50.", "sunrise was about 06:35 and sunset about 16:50 (Kyiv time)."), confidence_note = "Clock corrected (2026-10-14): the reanalysis times were taken on UTC+3, which is Moscow time in winter; Ukraine keeps EET (UTC+2) from the last Sunday of October to the last Sunday of March. Recomputed with the NOAA solar equations; the corrected times are the recorded ones less one hour." WHERE text CONTAINS "sunrise was about 07:35 and sunset about 17:50.";
UPDATE claim:cc12_0017_02 SET text = string::replace(text, "sunset was at 17:16,", "sunset was at 16:16 Kyiv time (17:16 on the Moscow time kept on the occupied coast),"), confidence_note = "moon computed from the mean synodic month; approximate; sunset time (16:16 Kyiv, 17:16 Moscow) not recorded as an observation. Clock corrected (2026-10-14): the reanalysis times were taken on UTC+3, which is Moscow time in winter; Ukraine keeps EET (UTC+2) from the last Sunday of October to the last Sunday of March. Recomputed with the NOAA solar equations; the corrected times are the recorded ones less one hour." WHERE text CONTAINS "sunset was at 17:16,";
UPDATE claim:cc12_0017_05 SET text = string::replace(text, "sunset was at 18:03 Kyiv time", "sunset was at 17:03 Kyiv time (18:03 Moscow time, the local clock)"), confidence_note = "moon approximate; sunset time not recorded as an observation. Clock corrected (2026-10-14): the reanalysis times were taken on UTC+3, which is Moscow time in winter; Ukraine keeps EET (UTC+2) from the last Sunday of October to the last Sunday of March. Recomputed with the NOAA solar equations; the corrected times are the recorded ones less one hour." WHERE text CONTAINS "sunset was at 18:03 Kyiv time";
UPDATE claim:cc12_0017_06 SET text = string::replace(text, "If HUR's 18:45 time for the 23 February 2024 A-50 kill is Kyiv time (the source does not say), the kill came at dusk, which fits the crash videos.", "If HUR's 18:45 time for the 23 February 2024 A-50 kill is Moscow time, the kill came in nautical twilight, at dusk, which fits the crash videos; on Kyiv time it came just after astronomical dusk, in full dark (the source does not say which)."), confidence_note = "Corrected (2026-10-14): sunset at Primorsko-Akhtarsk on 23 Feb 2024 was 15:03 UTC (17:03 Kyiv, 18:03 Moscow); civil dusk 15:33, nautical 16:08, astronomical 16:43 UTC (NOAA solar equations). 18:45 Moscow is 15:45 UTC, in nautical twilight; 18:45 Kyiv is 16:45 UTC, past astronomical dusk. The earlier text took the Moscow-time sunset for Kyiv time and so reversed the conclusion." WHERE text CONTAINS "If HUR's 18:45 time for the 23 February 2024 A-50 kill is Kyiv time (the source does not say), the kill came at dusk, which fits the crash videos.";
UPDATE claim:cc15_0016_14 SET text = string::replace(text, "sunset at Pokrovsk is about 16:40", "sunset at Pokrovsk is about 15:40 Kyiv time"), confidence_note = "Clock corrected (2026-10-14): the reanalysis times were taken on UTC+3, which is Moscow time in winter; Ukraine keeps EET (UTC+2) from the last Sunday of October to the last Sunday of March. Recomputed with the NOAA solar equations; the corrected times are the recorded ones less one hour." WHERE text CONTAINS "sunset at Pokrovsk is about 16:40";
